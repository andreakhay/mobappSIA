# ====================================================================
# DIOCESE OF CAMARINES NORTE (DAET) MOBILE APP - ENVIRONMENT CONFIG
# ====================================================================

# 1. MOBILE APP API ENDPOINT (Client-Side)
# Point this to your backend server or Vercel deployment.
# When you replace the database or change servers, change this URL:
EXPO_PUBLIC_API_URL=https://diocese-of-daet.vercel.app/api

# 2. BACKEND DATABASE PARAMETERS (Server-Side Reference)
# These are used by the backend API server (e.g. Next.js / Node.js API routes)
# that directly connects to the TiDB Cloud MySQL database:
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=your_user_here
# DB_PASSWORD=your_password_here
# DB_NAME=diocese_system
# DB_SSL=true
